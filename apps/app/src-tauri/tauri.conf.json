{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atorch Load",
  "version": "0.1.0",
  "identifier": "dev.atorch.load",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Atorch Load",
        "width": 1440,
        "height": 960,
        "minWidth": 850,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "ATORCH electronic load controller",
    "category": "Utility"
  }
}
